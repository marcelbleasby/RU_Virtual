<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Pre-API-31 fallback; mirrors data_extraction_rules.xml.
         mennu_secure_prefs holds the bearer auth token + vCardId (active NFC
         credential) — must not silently restore onto a new device without
         re-authenticating against the server. -->
    <exclude domain="sharedpref" path="mennu_secure_prefs.xml"/>
</full-backup-content>