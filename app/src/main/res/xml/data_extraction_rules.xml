<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- mennu_secure_prefs holds the bearer auth token + vCardId (active
             NFC credential) — must not silently restore onto a new device
             without re-authenticating against the server. -->
        <exclude domain="sharedpref" path="mennu_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mennu_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>